{
  "name": "video-pipeline-blueprint",
  "version": "1.0.0",
  "private": true,
  "description": "Reference deployment of a code-driven video pipeline: Remotion scenes, local TTS narration, programmatic score, objective QA gates.",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still",
    "render": "remotion render",
    "typecheck": "tsc --noEmit",
    "browser": "remotion browser ensure",
    "score": "node scripts/audio/render_music.mjs",
    "mix": "node scripts/audio/mix.mjs",
    "gate:music": "python3 scripts/qa/music_gate.py",
    "lint:still": "node scripts/qa/still_lint.mjs",
    "lint:type": "python3 scripts/qa/type_ratchet.py",
    "publish": "node scripts/export/publish.mjs",
    "verify": "bash scripts/verify.sh",
    "make": "node scripts/make.mjs",
    "lint:3d": "node scripts/qa/three_frame_lint.mjs --composition=ThreeStage --frames=150,450,750 --repeat",
    "lint:model": "node scripts/qa/model_lint.mjs \"public/models/*.glb\" --watertight --allow=no-normals",
    "plates": "bash scripts/blender/render_plates.sh",
    "lint:plates": "node scripts/qa/plate_lint.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.536",
    "@remotion/three": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "katex": "0.16.22",
    "node-web-audio-api": "^2.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "three": "0.186.1",
    "typescript": "7.0.2"
  }
}
