{
 "lines": [
  "def karatsuba(x, y):",
  "    n = max(x.bit_length(), y.bit_length())",
  "    if n <= 70:                     # base case: one machine word",
  "        return x * y                #   schoolbook -> n^2 digit ops",
  "    n = (n // 2) * 8                # split on a byte boundary",
  "    mask = (1 << n) - 1",
  "    x0, x1 = x & mask, x >> n",
  "    y0, y1 = y & mask, y >> n",
  "    z0 = karatsuba(x0, y0)",
  "    z2 = karatsuba(x1, y1)",
  "    z1 = karatsuba(x0 + x1, y0 + y1) - z0 - z2",
  "    return z0 + (z1 << n) + (z2 << (2 * n))"
 ],
