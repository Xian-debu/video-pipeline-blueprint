node_modules/
out/
.remotion/
public/music/*.wav
public/voice/narration.wav
public/voice/mult_narration.wav
public/voice/gears_narration.wav
public/voice/gears/
data/mult/lines.json
data/gears/lines.json
# gears: params.json (inputs) and voice.json (measured narration) are the only sources.
# Everything else under data/gears is written by scripts/generate_gear_data.py — never committed,
# so a reviewer of a diff is looking at inputs, not at numbers that were already derived from them.
data/gears/*.json
!data/gears/params.json
!data/gears/voice.json
public/manim/*.mov
# Blender plates (P16): rendered artifacts described by report.json, never committed.
public/plates/
*.log
public/voice/hawk/
public/voice/hawk_narration.wav
data/hawk/lines.json
data/hawk/clips.json
# hawk: eval.json (the hand-written number ledger) and voice.json (measured narration) are the
# sources; gray.json and wave.json are written by scripts/generate_hawk_data.py — same policy as
# data/gears, so the generator is in the gate (make.mjs / verify.sh step 0.5) instead of the repo.
data/hawk/gray.json
data/hawk/wave.json
public/voice/arc/
public/voice/arc_narration.wav
data/arc/lines.json
data/arc/clips.json
# arc: eval.json (the hand-written number ledger) and voice.json (measured narration) are the
# sources; sim.json is written by scripts/generate_arc_data.py — same policy as gears/hawk.
data/arc/sim.json
public/voice/quickselect/
public/voice/quickselect_narration.wav
data/quickselect/lines.json
data/quickselect/clips.json
# quickselect: sources.json (the hand-written citation ledger) and voice.json (measured narration)
# are the sources; the five *.json ledgers are written by scripts/generate_quickselect_data.py —
# same policy as gears/hawk/arc, so the generator sits in the gate instead of the numbers.
data/quickselect/bench.json
data/quickselect/timing.json
data/quickselect/trace.json
data/quickselect/degradation.json
data/quickselect/bfprt.json

# python bytecode from the asset/generator scripts
__pycache__/
# char: the model is authored by scripts/char/gen.py and committed as ledgers (params.json,
# gate.json, plates.json, bones.json); the plates themselves are renders (public/plates/ is
# already ignored) and the narration is derived from data/char/voice.json.
public/voice/char/
public/voice/char_narration.wav
data/char/lines.json
data/char/clips.json
data/char/runs/
